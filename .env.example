# Local development only. Generate unique values before any shared deployment.
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-another-32-random-characters
APP_PORT=8080
PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
SEED_DEMO_DATA=false
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-bootstrap-password
BOOTSTRAP_ADMIN_USERNAME=director
BOOTSTRAP_ADMIN_NAME=Atlas Director
BOOTSTRAP_COMPANY_NAME=Atlas
TRUST_PROXY=2

# Optional integrations. They remain visibly disabled when unset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Mail: required to connect mailboxes. Generate with: openssl rand -base64 32
MAIL_ENCRYPTION_KEY=
# Set only while rotating keys: the old key, so stored credentials still open.
MAIL_ENCRYPTION_KEY_PREVIOUS=
MAIL_SYNC_DAYS=90
MAIL_POLL_SECONDS=120
MAIL_ALLOW_PRIVATE_HOSTS=false
TELEGRAM_BOT_TOKEN=
# Required with a bot token in webhook mode. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# webhook (needs HTTPS PUBLIC_URL) or polling (local development, no HTTPS)
TELEGRAM_MODE=webhook
WHATSAPP_ACCESS_TOKEN=
VIBER_AUTH_TOKEN=
